{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ARC RACE：Python 3.11 自動テスト",
      "type": "process",
      "command": "py",
      "args": [
        "-3.11",
        "scripts/run_local_tests.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Ctrl+Shift+Bで実行。Windowsに時刻データが無い場合のみtzdataを導入し、認証キーや有料JRDBを使わない合成テストを実行します。"
    }
  ]
}

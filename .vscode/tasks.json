{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ARC RACE：Python 3.11 自動テスト",
      "type": "process",
      "command": "py",
      "args": [
        "-3.11",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Ctrl+Shift+Bで実行。認証キーやJRDB有料APIを使わないローカルの合成テストです。"
    }
  ]
}

{
  "name": "KEIBA NINE — private JRDB development (no API calls on startup)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "KEIBA NINE owner-only preview",
      "visibility": "private",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "JRDB_PRIVATE_ENABLED": "0"
  },
  "postCreateCommand": "python -m unittest discover -s tests -p 'test_*.py'"
}
